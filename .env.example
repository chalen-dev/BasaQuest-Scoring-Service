# Supabase project (same project the frontend uses)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# service_role key -- server-side only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Azure AI Speech resource
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=your-azure-region

# Port the service listens on (Railway/Render set this automatically in prod)
PORT=8787

# Comma-separated list of origins allowed to call this service (your deployed
# frontend URL, plus http://localhost:5173 for local dev)
ALLOWED_ORIGINS=http://localhost:5173